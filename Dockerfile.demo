FROM python:3.12-slim
WORKDIR /app
COPY release/mobile-web/backend/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir -r /tmp/requirements.lock \
    && useradd --uid 10001 --create-home meal \
    && mkdir -p /data/photos /app/release/mobile-web/.data \
    && chown -R meal:meal /data /app
COPY release/mobile-web/backend release/mobile-web/backend
COPY release/mobile-web/dist release/mobile-web/dist
COPY demo demo
USER meal
ENV DATABASE_URL=sqlite:////data/meals.sqlite3 MEDIA_ROOT=/data/photos
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "demo.app:create_demo_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
