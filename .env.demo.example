# Copy to .env.demo in the repository root. Keep private configuration here.
DATABASE_URL=
MEDIA_ROOT=
ALLOWED_HOSTS=127.0.0.1,localhost
# false for local HTTP; true behind an HTTPS reverse proxy.
COOKIE_SECURE=false
OPENAI_BASE_URL=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
VISION_MODEL=
VISION_ENABLE_THINKING=false
VISION_TIMEOUT_SECONDS=30
VISION_DAILY_LIMIT=50
# Docker Compose defaults to loopback. Use 0.0.0.0 only for a network demo.
DEMO_BIND=127.0.0.1
DEMO_PORT=5177
