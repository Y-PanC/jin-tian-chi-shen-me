# Local SQLite is created in .data/; deployment can use PostgreSQL.
DATABASE_URL=
MEDIA_ROOT=
COOKIE_SECURE=false
ALLOWED_HOSTS=127.0.0.1,localhost
# Normal startup creates Yunzhong / 1234567890 with 33 saved meals once.
SEED_DEMO_ACCOUNT=true
# Keep these empty until a vision provider has been selected.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Alternatively set DASHSCOPE_API_KEY for Alibaba Cloud Model Studio.
DASHSCOPE_API_KEY=
VISION_MODEL=
VISION_ENABLE_THINKING=false
VISION_TIMEOUT_SECONDS=30
VISION_DAILY_LIMIT=50
